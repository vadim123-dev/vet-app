# Terraform local state — main infra state lives in S3 remote backend;
# bootstrap state is intentionally local (bootstrap creates the S3 bucket,
# so it cannot use S3 as its own backend). Safe to delete once bootstrap
# has run; resources remain in AWS regardless.
*.tfstate
*.tfstate.backup

# Terraform provider cache — downloaded binaries (~500MB–1.5GB per module).
# Not state; fully regenerated by `terraform init`. Safe to delete.
.terraform/

# Provider lock file — pins provider versions. Excluded here because each
# module (infra/ and bootstrap/) manages its own versions independently.
.terraform.lock.hcl

# Secret variable files — never commit
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log
